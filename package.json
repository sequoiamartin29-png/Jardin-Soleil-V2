{
  "name": "jardin-soleil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private garden companion for plant care, records, learning, and botanical play.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "native:sync": "npm run build && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios",
    "verify": "npm run build && npm run verify:storage && npm run verify:native && npm run verify:learning && npm run verify:health-alerts",
    "verify:customer": "node scripts/verify-customer-flow.mjs",
    "verify:dashboard": "node scripts/verify-dashboard-layout.mjs",
    "verify:wildlife": "node scripts/verify-wildlife.mjs",
    "verify:health-alerts": "node scripts/verify-plant-health-alerts.mjs",
    "verify:fruit-tree-delete": "node scripts/verify-fruit-tree-deletion.mjs",
    "verify:learning": "node scripts/verify-learning-center.mjs",
    "verify:storage": "node scripts/verify-storage-recovery.mjs",
    "verify:native": "node scripts/verify-store-readiness.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@vitejs/plugin-react": "latest",
    "vite": "latest"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
