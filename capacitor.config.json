{
  "appId": "com.tierrafleur.jardinsoleil",
  "appName": "Jardin Soleil",
  "webDir": "dist",
  "backgroundColor": "#f5ecd8",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": false,
      "backgroundColor": "#f5ecd8",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#f5ecd8",
      "overlaysWebView": false
    }
  }
}
